{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "athens-gis-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [],

  // Workers AI binding - used to call the Llama model
  "ai": {
    "binding": "AI"
  },

  // Native Cloudflare Rate Limiting binding (no KV/Durable Objects needed).
  // namespace_id is a locally-chosen identifier, not something fetched from
  // the dashboard - any unique small integer-as-string works.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
